# Docker Compose secrets for the local infrastructure (db / redis / minio).
# Copy this file to `.env` and adjust the values. The `.env` file is gitignored.
#
# WARNING: the values below are DEV-ONLY defaults. Before any non-local
# deployment, set strong unique secrets and run the data volumes on an
# encrypted disk (encryption at rest).

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=project_03
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PASSWORD=redis
REDIS_PORT=6379

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- App containers (dev, hot-reload) ---
BACKEND_PORT=3000
FRONTEND_PORT=4200
