# Dev-only image: hot-reload via `ng serve`, source bind-mounted by
# docker-compose.yml. Not intended for production (use `ng build` +
# a static file server / CDN for that).

FROM node:24.18.0-bookworm-slim

RUN corepack enable && corepack prepare pnpm@10.33.0 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

EXPOSE 4200

# --proxy-config points /api at the "backend" service name (Docker network),
# distinct from proxy.conf.json which targets localhost:3000 for a
# host-run `pnpm start`.
CMD ["pnpm", "exec", "ng", "serve", "--host", "0.0.0.0", "--port", "4200", "--proxy-config", "proxy.conf.docker.json"]
