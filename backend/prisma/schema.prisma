// Prisma schema file
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================
// Enums
// =====================================================================

enum Role {
  USER
  ADMIN
}

enum VerificationTokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

enum AuditAction {
  USER_REGISTERED
  USER_LOGIN
  USER_LOGOUT
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  EMAIL_CHANGED
  EMAIL_VERIFICATION_SENT
  EMAIL_VERIFIED
  ACCOUNT_DELETED
  REFRESH_TOKEN_REUSE_DETECTED
  DATA_EXPORTED
  SESSION_REVOKED
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

enum ApplicationStatus {
  WISHLIST // saved, not applied yet
  DRAFT // application in preparation
  APPLIED
  SCREENING // recruiter / phone screen stage
  INTERVIEW
  TECHNICAL_TEST
  OFFER
  ACCEPTED
  REJECTED
  WITHDRAWN
  GHOSTED // no news after follow-ups
}

enum WorkMode {
  ON_SITE
  HYBRID
  REMOTE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  APPRENTICESHIP
  FREELANCE
  TEMPORARY
}

enum ApplicationSource {
  JOB_BOARD
  LINKEDIN
  COMPANY_WEBSITE
  REFERRAL
  RECRUITER
  CAREER_FAIR
  SPONTANEOUS
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum SalaryPeriod {
  HOUR
  DAY
  MONTH
  YEAR
}

enum DocumentType {
  CV
  COVER_LETTER
  PORTFOLIO
  OFFER_LETTER
  CERTIFICATE
  OTHER
}

enum EmailTemplateCategory {
  FOLLOW_UP // relance sans nouvelles
  THANK_YOU // remerciement post-entretien
  COLD_OUTREACH // candidature spontanée
  OFFER_NEGOTIATION // négociation d'offre
  WITHDRAWAL // retrait de candidature
  OTHER
}

enum XpReason {
  APPLICATION_CREATED
  APPLICATION_SUBMITTED
  INTERVIEW_SCHEDULED
  INTERVIEW_COMPLETED
  OFFER_RECEIVED
  OFFER_ACCEPTED
  STREAK_BONUS
  DAILY_GOAL
  WEEKLY_GOAL
  ACHIEVEMENT_UNLOCKED
  /// Reversal entry: the only reason that carries a negative amount. Deleting
  /// an application takes back what it earned, so the ledger still sums to the
  /// profile total instead of crediting work that no longer exists.
  APPLICATION_DELETED
  OTHER
}

// =====================================================================
// Identity & auth
// =====================================================================

model User {
  // Internal surrogate key. Never leaves the process: it is what the 13
  // owning tables reference, so it stays a compact integer. Anything a client
  // can see uses `publicId` instead.
  id Int @id @default(autoincrement())

  // The only user identifier the API ever emits. Opaque and non-sequential,
  // so a client cannot infer how many accounts exist, and any future route
  // that takes a user identifier is not enumerable by construction.
  publicId String @unique @default(uuid())

  email            String    @unique
  // Null until the address is proven reachable. Verification is not a login
  // gate: it is what makes the address trustworthy as a recovery channel.
  emailVerifiedAt  DateTime?
  name             String?
  passwordHash     String // argon2id hash — never returned to clients
  avatarStorageKey String? // opaque S3 object key; never returned to clients (presigned URL is derived from it)
  role             Role      @default(USER)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Auth
  sessions           RefreshSession[]
  verificationTokens VerificationToken[]

  // Profile
  settings     UserSettings?
  gamification GamificationProfile?

  // Domain (all per-user isolated)
  companies      Company[]
  contacts       Contact[]
  applications   JobApplication[]
  documents      Document[]
  emailTemplates EmailTemplate[]
  xpEvents       XpEvent[]
  achievements   UserAchievement[]
}

// Refresh-token sessions: enables rotation, revocation and reuse/theft detection.
model RefreshSession {
  id        String    @id @default(uuid())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String // sha256 of the opaque refresh token — the raw token is never stored
  familyId  String // rotation family; reusing a revoked token revokes the whole family
  // When the family was opened, carried on every row of it. A device that stays
  // signed in rotates every 15 minutes, so the row's own createdAt says when it
  // last refreshed, not since when the user has been connected. Denormalised
  // rather than derived from min(createdAt) so the answer survives the
  // retention purge of the family's older rows.
  familyCreatedAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  // Listing a user's active sessions, and the retention purge's dead-row scan.
  @@index([userId, revokedAt, expiresAt])
}

// Single-use, short-lived tokens sent by e-mail: password recovery and address
// verification. Only the keyed hash is stored (see VerificationTokenService),
// so a database dump cannot be replayed into an account takeover.
model VerificationToken {
  id         String                   @id @default(uuid())
  userId     Int
  user       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    VerificationTokenPurpose
  tokenHash  String                   @unique
  // The address the token was sent to. A token stops being valid once the
  // account moves to another address, so a recovery link mailed to an old
  // (possibly compromised) inbox cannot be redeemed afterwards.
  email      String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime                 @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

/// Append-only trail of security-relevant events: who, what, when, from where.
///
/// Deliberately has no foreign key to User. Two reasons, both structural:
/// account deletion is itself an audited event, so the row has to outlive the
/// account; and `onDelete: SetNull` would issue an UPDATE, which the
/// append-only trigger installed by the migration rejects outright.
///
/// Nothing directly identifying is stored — no address, no name, no request
/// body. Once the account is gone, `userId` is an integer pointing at nothing
/// (autoincrement never reuses a value, so it stays unambiguous).
model AuditLog {
  id         String       @id @default(uuid())
  occurredAt DateTime     @default(now())
  action     AuditAction
  outcome    AuditOutcome
  /// Internal User.id, or null when the actor is unauthenticated or unknown
  /// (failed login on an address with no account).
  userId     Int?
  /// Truncated to 45 chars (max IPv6 length) by AuditService.
  ip         String?
  /// Truncated to 255 chars by AuditService.
  userAgent  String?
  /// Ties the entry to the application logs for the same request.
  correlationId String?
  /// Small, non-identifying facts only (a failure reason, a counter, a session
  /// family id). Never PII, never a token, never a request body.
  metadata   Json?

  @@index([userId, occurredAt])
  @@index([action, occurredAt])
  @@index([occurredAt])
}

model UserSettings {
  id                    String   @id @default(uuid())
  userId                Int      @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  locale                String   @default("fr")
  timezone              String   @default("Europe/Paris")
  weeklyApplicationGoal Int      @default(5) // gamified target: applications per week
  emailRemindersEnabled Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// =====================================================================
// Job-search domain
// =====================================================================

model Company {
  id        String   @id @default(uuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  website   String?
  industry  String?
  location  String?
  size      String? // e.g. "1-10", "11-50", "51-200", ...
  logoUrl   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications JobApplication[]
  contacts     Contact[]

  @@index([userId])
}

model Contact {
  id          String   @id @default(uuid())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  firstName   String
  lastName    String?
  email       String?
  phone       String?
  title       String? // role at the company (e.g. "Talent Acquisition")
  linkedinUrl String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  primaryForApplications JobApplication[] @relation("ApplicationPrimaryContact")

  @@index([userId])
  @@index([companyId])
}

// Shared, read-only reference data pulled from a public company registry
// (SIRENE/INSEE for France). Not tenant-scoped: this is not user data, it's
// a lookup table every authenticated user can search. Rows are only ever
// written by CompanyRegistrySyncService — never mutated through the API.
model CompanyRegistryEntry {
  id              String    @id @default(uuid())
  siret           String    @unique // établissement, 14 digits
  siren           String // parent legal entity (unité légale), 9 digits
  name            String? // denomination, or name for a personne physique
  naf             String? // primary activity code (APE/NAF)
  addressLine     String?
  postalCode      String?
  commune         String?
  departmentCode  String?
  regionCode      String?
  status          String // active / ceased (etatAdministratifEtablissement)
  // INSEE's own "diffusion partielle" opt-out flag. False means the source
  // entity asked not to be publicly disclosed — never store/serve fields for
  // these rows beyond what INSEE itself would publicly disclose.
  isDiffusible    Boolean   @default(true)
  sourceUpdatedAt DateTime? // dateDerniereMiseAJour from SIRENE
  syncedAt        DateTime  @default(now())

  @@index([departmentCode])
  @@index([regionCode])
  @@index([name])
}

// Singleton-per-source bookkeeping row for CompanyRegistrySyncService, so a
// crashed full sync resumes from its cursor instead of restarting, and the
// incremental cron knows the last successful watermark.
model RegistrySyncState {
  id                    String    @id // fixed key, e.g. "sirene-fr"
  lastCursor            String?
  lastFullSyncAt        DateTime?
  lastIncrementalSyncAt DateTime?
  status                String    @default("idle") // idle / running / error
  lastError             String?
}

model JobApplication {
  id        String   @id @default(uuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  position    String
  companyName String? // free-text fallback when no Company record is linked yet
  description String?

  status         ApplicationStatus  @default(WISHLIST)
  source         ApplicationSource?
  jobUrl         String?
  location       String?
  workMode       WorkMode?
  employmentType EmploymentType?
  priority       Priority           @default(MEDIUM)
  excitement     Int? // personal 1..5 rating (validated in the app layer)

  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String       @default("EUR") // ISO 4217 code
  salaryPeriod   SalaryPeriod @default(YEAR)

  appliedAt  DateTime?
  deadlineAt DateTime?
  closedAt   DateTime? // when it reached a terminal status (accepted/rejected/withdrawn)

  notes      String?
  isFavorite Boolean   @default(false)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  primaryContactId String?
  primaryContact   Contact? @relation("ApplicationPrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull)

  statusHistory ApplicationStatusEvent[]
  documents     Document[]
  xpEvents      XpEvent[]

  @@index([userId])
  @@index([userId, status])
  @@index([companyId])
  @@index([primaryContactId])
}

// Status transitions over time — the backbone of the pipeline/funnel statistics.
model ApplicationStatusEvent {
  id            String             @id @default(uuid())
  applicationId String
  application   JobApplication     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  note          String?
  createdAt     DateTime           @default(now())

  @@index([applicationId])
}

// File metadata; the bytes live in MinIO/S3 under `storageKey`.
model Document {
  id            String          @id @default(uuid())
  userId        Int
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String?
  application   JobApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  type          DocumentType    @default(OTHER)
  label         String?
  storageKey    String // object key in the S3 bucket
  filename      String
  mimeType      String
  sizeBytes     Int
  createdAt     DateTime        @default(now())

  @@index([userId])
  @@index([applicationId])
}

// Reusable, plain-text mail templates with {{variable}} placeholders
// (poste, entreprise, contact_prenom, contact_nom, mon_nom) interpolated
// client-side from an application/contact when copied.
model EmailTemplate {
  id        String                @id @default(uuid())
  userId    Int
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  EmailTemplateCategory @default(OTHER)
  name      String
  subject   String
  body      String
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([userId])
}

// =====================================================================
// Gamification
// =====================================================================

model GamificationProfile {
  id                String    @id @default(uuid())
  userId            Int       @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  xp                Int       @default(0)
  level             Int       @default(1)
  currentStreakDays Int       @default(0)
  longestStreakDays Int       @default(0)
  lastActiveOn      DateTime? // date of last XP-earning activity, for streak tracking
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// Append-only ledger of XP awards — auditable and lets the profile total be recomputed.
model XpEvent {
  id            String          @id @default(uuid())
  userId        Int
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String?
  application   JobApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  amount        Int
  reason        XpReason
  /// Idempotency key for an award that must land at most once per subject
  /// (a milestone on one application, one interview, one achievement). NULL
  /// means repeatable — and NULLs never collide, so the unique index below
  /// leaves those rows alone. This is what stops a status flip-flop from
  /// paying out twice; see GamificationService.grantXp.
  dedupeKey     String?
  description   String?
  createdAt     DateTime        @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId])
  @@index([userId, createdAt])
}

// Catalog of achievements (seeded, shared across users).
model Achievement {
  id          String   @id @default(uuid())
  code        String   @unique // stable key, e.g. "FIRST_APPLICATION"
  name        String
  description String
  icon        String?
  xpReward    Int      @default(0)
  threshold   Int? // generic numeric criterion (e.g. N applications)
  createdAt   DateTime @default(now())

  users UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        Int
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  progress      Int         @default(0)
  unlockedAt    DateTime? // null while still in progress
  createdAt     DateTime    @default(now())

  @@unique([userId, achievementId])
  @@index([userId])
}
