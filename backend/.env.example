# Copy this file to `.env` and adjust the values for your environment.

# PostgreSQL connection string used by Prisma and the app.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/project_03?schema=public"

# HTTP server port
PORT=3000

# Comma-separated list of allowed origins for CORS (frontend dev server).
# Required in production, must be https, and "*" is rejected — credentialed
# CORS needs explicit origins.
CORS_ORIGIN="http://localhost:4200"

# Number of reverse proxies (load balancer, ingress, CDN) in front of the app.
# 0 = none: X-Forwarded-For is ignored and req.ip is the socket peer.
#
# Set this to the EXACT hop count when deploying behind a proxy. Too low and
# every user shares one rate-limit bucket (the proxy's IP), so a single
# attacker locks out the whole tenant base and session records log the proxy
# instead of the client. Too high and a client can forge X-Forwarded-For to
# appear as any IP it likes and slip its own limits.
TRUSTED_PROXY_HOPS=0

# Redis connection (cache / sessions / job queue). Matches docker-compose creds.
REDIS_URL="redis://:redis@localhost:6379"

# MinIO / S3-compatible object storage for attachments (CVs, cover letters, offer PDFs).
S3_ENDPOINT="http://localhost:9000"
# Endpoint used only when signing presigned GET URLs (avatars, documents) —
# must be reachable from the end user's browser. In docker-compose this
# differs from S3_ENDPOINT (see docker-compose.yml); outside Docker they're
# usually the same, so this can be left unset to fall back to S3_ENDPOINT.
S3_PUBLIC_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="project03-uploads"
S3_FORCE_PATH_STYLE=true

# Runtime environment: "development" | "production" | "test".
# In production, cookies are set Secure and missing secrets abort startup.
NODE_ENV=development

# --- Authentication ---
# Generate a strong, DISTINCT secret per variable per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# In production, boot fails if any of these is a placeholder, shorter than 32
# characters, or reused across two variables.
#
# JWT_ACCESS_SECRET signs the access-token JWT.
# JWT_REFRESH_SECRET keys the HMAC over stored refresh tokens — it lives
#   outside the database on purpose, so a database dump alone cannot be used
#   to mint a working session. Rotating it invalidates every refresh session
#   (all users must log in again); the access-token cookie survives its 15m TTL.
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
CSRF_SECRET="change-me-csrf-secret"

# Token lifetimes
ACCESS_TOKEN_TTL="15m"        # zeit/ms format (e.g. 15m, 1h)
REFRESH_TOKEN_TTL_DAYS=7      # whole days
